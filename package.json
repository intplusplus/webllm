{
  "name": "webllm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "浏览器内自研 LLM 引擎：WebGPU + WGSL，从零实现训练与推理闭环",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "signal": "node scripts/signal-server.mjs",
    "demo": "node scripts/start-demo.mjs",
    "demo:https": "node scripts/start-demo.mjs --https",
    "probe:webgpu": "node scripts/probe-webgpu.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "verify:fed": "node scripts/verify-fed.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:signal": "node scripts/verify-signal.mjs",
    "verify:phone": "node scripts/verify-phone.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "fetch:model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.52",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}